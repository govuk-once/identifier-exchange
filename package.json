{
  "name": "identifier-exchange",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry-prod-904690835784.d.codeartifact.eu-west-2.amazonaws.com/npm/registry-prod-repo"
  },
  "scripts": {
    "cdk:main": "cdk --app 'npx ts-node --prefer-ts-exts bin/main.app.ts'",
    "cdk:decoupled": "cdk --app 'npx ts-node --prefer-ts-exts bin/decoupled.app.ts'",
    "cdk:app": "cdk --app 'npx ts-node --prefer-ts-exts'",
    "synth:main": "pnpm cdk:main -- synth",
    "deploy:main": "pnpm cdk:main -- deploy --all --require-approval never",
    "synth:decoupled": "pnpm cdk:decoupled -- synth",
    "deploy:decoupled": "pnpm cdk:decoupled -- deploy --all --require-approval never",
    "test": "vitest ."
  },
  "dependencies": {
    "@govuk-connect/tag": "^1.0.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@govuk-connect/dev": "0.0.13",
    "@types/node": "24.13.3",
    "aws-cdk": "2.1136.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "once": {
    "team": "identity",
    "aws": {
      "region": "eu-west-2",
      "roles": {
        "dev": "once-identifier-exchange-development-admin"
      }
    }
  }
}
